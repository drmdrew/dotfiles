#!/bin/bash
# vim-plugins: install the plugins in vim/plugins.txt into ~/.vim/pack/plugins/start,
# each checked out detached at its pinned commit.
set -euo pipefail

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
MANIFEST=$DOTFILES/vim/plugins.txt
DEST=${VIM_PACK_DIR:-$HOME/.vim/pack/plugins/start}

mkdir -p "$DEST"

while read -r name url sha; do
    case "$name" in ''|\#*) continue ;; esac
    dir=$DEST/$name
    if [ ! -d "$dir/.git" ]; then
        git clone --quiet --no-checkout "$url" "$dir"
    fi
    git -C "$dir" remote set-url origin "$url"
    if ! git -C "$dir" checkout --quiet --force --detach "$sha" 2>/dev/null; then
        git -C "$dir" fetch --quiet origin
        git -C "$dir" checkout --quiet --force --detach "$sha"
    fi
    echo "$name @ ${sha:0:8}"
done < "$MANIFEST"
