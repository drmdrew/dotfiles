#!/bin/sh
# excalidraw - render/extract Excalidraw diagrams (see ../SKILL.md).
# Only runs the built renderer; it never installs or builds. `mise run setup`
# in this directory does that, and records which node to use in dist/node.
set -eu
DIR=$(cd "$(dirname "$0")" && pwd)
BUNDLE="$DIR/dist/render.mjs"
SETUP="mise -C $DIR run setup"

if [ ! -f "$BUNDLE" ] || [ ! -f "$DIR/dist/stamp" ] || [ ! -f "$DIR/dist/node" ]; then
    echo "excalidraw: renderer not built: ask the user to run: $SETUP" >&2
    exit 2
fi
if [ "$("$DIR/stamp")" != "$(cat "$DIR/dist/stamp")" ]; then
    echo "excalidraw: renderer out of date: ask the user to run: $SETUP" >&2
    exit 2
fi
NODE=$(cat "$DIR/dist/node")
if [ ! -x "$NODE" ]; then
    echo "excalidraw: node not found at $NODE: ask the user to run: $SETUP" >&2
    exit 2
fi

exec "$NODE" "$BUNDLE" "$@"
